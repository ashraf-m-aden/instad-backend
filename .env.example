# Port d'ecoute HTTP du serveur Express (doit matcher docker-compose.yml)
PORT=3001

# Connexion MongoDB (conteneur "mongo" sur le reseau Docker interne)
MONGODB_URL=mongodb://instad_admin:CHANGE_ME_STRONG_PASSWORD@mongo:27017/instad?authSource=admin

# Identifiants admin MongoDB (utilises par le conteneur mongo ET par le script de backup)
MONGO_ROOT_USER=instad_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Secret de signature des JWT (chaine aleatoire longue, ex: openssl rand -hex 32)
jwt_secret=CHANGE_ME_LONG_RANDOM_SECRET

# AWS (region uniquement - les identifiants viennent du role IAM attache a l'instance EC2)
AWS_REGION=eu-west-3

# Bucket des fichiers publics servis au site (publications, images, medias).
# Cible de POST /upload : les objets doivent etre lisibles publiquement
# (bucket policy s3:GetObject sur *), le role IAM de l'EC2 ayant s3:PutObject
# et s3:DeleteObject dessus. C'est aussi le bucket vise par
# src/scripts/migrate-firebase-urls-to-s3.js.
S3_UPLOADS_BUCKET=instad-uploads-prod

S3_BACKUPS_BUCKET=instad-backups-prod

# Taille maximale d'un fichier envoye via POST /upload, en Mo (defaut : 100)
UPLOAD_MAX_SIZE_MB=100
